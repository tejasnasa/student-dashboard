# Supabase Configuration
# The API URL of your Supabase project (from Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The Publishable Anon Key of your Supabase project (from Settings > API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_anon_key_here

# The database password (required if executing seeding scripts directly)
NEXT_PUBLIC_SUPABASE_PASSWORD=your_database_password_here
